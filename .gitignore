# Compilador local y herramientas descargadas
.tools/
.worktrees/

# Credenciales locales (usar secrets.example.h como plantilla)
secrets.h

# Entorno local de la réplica Docker
docker/.env
docker/data/

# Archivos auxiliares generados por LaTeX
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc

# El PDF de trabajo se regenera al compilar
/SmartSense_IEEE.pdf

# Copias históricas locales; no forman parte de la entrega versionada
/PDF_Para_Compartir/Articulo_SmartSense_HardwareX.pdf
/PDF_Para_Compartir/Tesis_SmartSense_Monitoring.pdf

# Archivos temporales del sistema y de Office
Thumbs.db
.DS_Store
~$*

# Caché local de Python
__pycache__/
*.py[cod]

